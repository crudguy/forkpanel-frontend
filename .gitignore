# ── 依赖与构建产物（运行期内嵌进 Rust 二进制，不入库）──
node_modules/
dist/
dist-ssr/
*.local

# 覆盖率报告（`vitest run --coverage` 的产物，仅本地/CI 查看）
coverage/

# ── 编辑器 / OS 噪声 ──
.idea/
.vscode/
*.swp
.DS_Store

# ── 运行期由后端注入，不在此仓库管理 ──
.env
.env.*

# ── WorkBuddy 工作区数据（会话记忆 / 临时脚本与备份，不入库）──
.workbuddy/

# 本地 dev 运行日志（运行期产生，不入库）
.dev-frontend.log
