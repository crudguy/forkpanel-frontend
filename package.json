{
  "name": "forkpanel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ForkPanel（叉叉面板）前端：Vue 3 + TS，构建产物内嵌进 Rust 二进制，运行期零 Node",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-no-comments.mjs",
    "preview": "vite preview",
    "size": "node scripts/size-report.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:ui": "node scripts/run-ui-guards.mjs",
    "check:contract": "bash ci/check-contract.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
